generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(150)
  email        String   @default("") @db.VarChar(254)
  firstName    String   @default("") @map("first_name") @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isSuperuser  Boolean  @default(false) @map("is_superuser")
  isStaff      Boolean  @default(false) @map("is_staff")
  isActive     Boolean  @default(true) @map("is_active")
  dateJoined   DateTime @default(now()) @map("date_joined")

  memberships      CompanyMember[]
  appointments     Appointment[]
  favorites        FavoriteCompany[]
  notes            CustomerNote[]
  sessions         AuthSession[]
  createdCompanies Company[]         @relation("CompanyCreatedBy")
  audits           AuditLog[]

  @@map("users")
}

model Company {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(120)
  slug              String   @unique @db.VarChar(140)
  category          String   @default("") @db.VarChar(60)
  city              String   @default("") @db.VarChar(80)
  searchText        String   @default("") @map("search_text")
  description       String   @default("") @db.VarChar(255)
  address           String   @default("") @db.VarChar(255)
  active            Boolean  @default(true)
  logoPath          String?  @map("logo_path") @db.VarChar(255)
  notifyCustomers   Boolean  @default(true) @map("notify_customers")
  notifyAdmins      Boolean  @default(true) @map("notify_admins")
  minNoticeHours    Int      @default(0) @map("min_notice_hours")
  cancelNoticeHours Int      @default(0) @map("cancel_notice_hours")
  createdById       Int?     @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  createdBy     User?             @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  openingHours  CompanyHours[]
  photos        CompanyPhoto[]
  members       CompanyMember[]
  services      Service[]
  professionals Professional[]
  timeOff       TimeOff[]
  favoritedBy   FavoriteCompany[]
  customerNotes CustomerNote[]
  audits        AuditLog[]

  @@map("companies")
}

model PlatformSettings {
  id                  Int @id @default(1)
  maxCompaniesPerUser Int @default(10) @map("max_companies_per_user")

  @@map("platform_settings")
}

model CompanyHours {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  weekday   Int
  startTime String  @map("start_time") @db.VarChar(8)
  endTime   String  @map("end_time") @db.VarChar(8)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_hours")
}

model CompanyPhoto {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  imagePath String   @map("image_path") @db.VarChar(255)
  caption   String   @default("") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_photos")
}

model CompanyMember {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  userId    Int     @map("user_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

model Service {
  id          Int    @id @default(autoincrement())
  companyId   Int    @map("company_id")
  name        String @db.VarChar(100)
  description String @default("") @db.VarChar(255)

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offers       ProfessionalService[]
  appointments Appointment[]

  @@map("services")
}

model Professional {
  id            Int     @id @default(autoincrement())
  companyId     Int     @map("company_id")
  name          String  @db.VarChar(120)
  bio           String  @default("") @db.VarChar(255)
  active        Boolean @default(true)
  slotMinutes   Int     @default(30) @map("slot_minutes")
  bufferMinutes Int     @default(0) @map("buffer_minutes")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offers       ProfessionalService[]
  workingHours WorkingHours[]
  breaks       Break[]
  appointments Appointment[]
  timeOff      TimeOff[]

  @@map("professionals")
}

model ProfessionalService {
  id              Int      @id @default(autoincrement())
  professionalId  Int      @map("professional_id")
  serviceId       Int      @map("service_id")
  durationMinutes Int      @default(30) @map("duration_minutes")
  price           Decimal? @db.Decimal(8, 2)
  slotMinutes     Int?     @map("slot_minutes")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@map("professional_services")
}

model WorkingHours {
  id             Int          @id @default(autoincrement())
  professionalId Int          @map("professional_id")
  weekday        Int
  startTime      String       @map("start_time") @db.VarChar(8)
  endTime        String       @map("end_time") @db.VarChar(8)
  slotMinutes    Int?         @map("slot_minutes")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("working_hours")
}

model Break {
  id             Int          @id @default(autoincrement())
  professionalId Int          @map("professional_id")
  weekday        Int
  startTime      String       @map("start_time") @db.VarChar(8)
  endTime        String       @map("end_time") @db.VarChar(8)
  label          String       @default("") @db.VarChar(60)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("breaks")
}

model Appointment {
  id             Int      @id @default(autoincrement())
  professionalId Int      @map("professional_id")
  serviceId      Int      @map("service_id")
  customerId     Int      @map("customer_id")
  start          DateTime
  end            DateTime
  status         String   @default("confirmed") @db.VarChar(10)
  notes          String   @default("") @db.VarChar(255)
  price          Decimal? @db.Decimal(8, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer     User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  review       Review?

  @@index([professionalId, start])
  @@index([customerId])
  @@map("appointments")
}

model Review {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique @map("appointment_id")
  rating        Int
  comment       String      @default("") @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model CustomerNote {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  customerId Int      @map("customer_id")
  notes      String   @default("")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, customerId])
  @@map("customer_notes")
}

model TimeOff {
  id             Int           @id @default(autoincrement())
  companyId      Int           @map("company_id")
  professionalId Int?          @map("professional_id")
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  reason         String        @default("") @db.VarChar(120)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("time_off")
}

model FavoriteCompany {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  companyId Int      @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("favorite_companies")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  actorId      Int?     @map("actor_id")
  actorLabel   String   @default("") @map("actor_label") @db.VarChar(255)
  action       String   @db.VarChar(40)
  companyId    Int?     @map("company_id")
  companyLabel String   @default("") @map("company_label") @db.VarChar(140)
  targetType   String   @default("") @map("target_type") @db.VarChar(40)
  targetId     Int?     @map("target_id")
  targetLabel  String   @default("") @map("target_label") @db.VarChar(255)
  details      Json     @default("{}")
  ip           String?  @db.VarChar(45)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model AuthSession {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  keyHash    String   @unique @map("key_hash") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  userAgent  String   @default("") @map("user_agent") @db.VarChar(255)
  ip         String?  @db.VarChar(45)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}
