# --- Supabase / Postgres ---------------------------------------------------
# Runtime (pooler em modo transação, porta 6543): Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrações (conexão direta, porta 5432) — usada só por `prisma migrate deploy`
DIRECT_URL="postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres"

# --- Supabase Storage (logo e fotos das empresas) --------------------------
SUPABASE_URL="https://PROJETO.supabase.co"
# Project Settings > API Keys > "Secret keys" (sb_secret_...). NUNCA no front. (SUPABASE_SERVICE_ROLE_KEY, a chave antiga, ainda é aceita.)
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_BUCKET="media"

# --- API ---------------------------------------------------------------------
# Origens do front autorizadas (CORS), separadas por vírgula
FRONTEND_URL="http://localhost:5173,https://seu-front.vercel.app"
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=30
PORT=8000

# --- E-mail (SMTP). Sem EMAIL_HOST os e-mails só são impressos no log ------------
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL="Agendamento <agenda@seudominio.com>"
